---
interface Props {
	node: {
		title?: string;
		body?: string;
	};
}

const { title, body } = Astro.props.node;
---

<aside class="callout" aria-label={title || "Callout"}>
	<div class="callout-marker" aria-hidden="true">Note</div>
	<div>
		{title && <h2 class="callout-title">{title}</h2>}
		{body && <p class="callout-body">{body}</p>}
	</div>
</aside>

<style>
	.callout {
		display: grid;
		grid-template-columns: auto minmax(0, 1fr);
		gap: 1rem;
		margin: 2.5rem 0;
		border-block: 1px solid var(--color-rule);
		padding: 1.25rem 0;
	}

	.callout-marker {
		padding-top: 0.2rem;
		color: var(--color-muted);
		font-size: 0.625rem;
		font-weight: 600;
		letter-spacing: 0.12em;
		line-height: 1.4;
		text-transform: uppercase;
	}

	.callout-title {
		margin: 0;
		font-size: 1rem;
		font-weight: 600;
		line-height: 1.5;
	}

	.callout-body {
		margin: 0.25rem 0 0;
		color: var(--color-muted);
		line-height: 1.7;
	}
</style>
