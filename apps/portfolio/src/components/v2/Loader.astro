---
import V2Logo from "./V2Logo.astro";
---

<div class="v2-loader" aria-hidden="true" data-v2-loader>
	<div class="v2-loader-inner">
		<V2Logo class="v2logo v2-loader-m" />
		<p class="v2-loader-name">MALIN / DHAMSARA</p>
		<div class="v2-loader-rule">
			<span class="v2-loader-rule-fill" data-v2-loader-rule></span>
		</div>
		<p class="v2-loader-pct tabular-nums">
			INITIALIZING <span data-v2-loader-num>000</span>%
		</p>
	</div>
</div>
