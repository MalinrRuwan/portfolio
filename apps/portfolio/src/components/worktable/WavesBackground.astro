---
/**
 * Decorative WebGL "waves" field. Place it inside a relative, sized container:
 *
 *   <section class="relative isolate ...">
 *     <WavesBackground preset="brand" class="absolute inset-0 -z-10" />
 *     ...
 *   </section>
 *
 * The shader is progressive enhancement — the wrapper is transparent and the
 * host's own background shows if WebGL is unavailable.
 */
interface Props {
	preset?: "brand" | "sand" | "rose" | "original";
	class?: string;
}

const { preset = "brand", class: className } = Astro.props;
---

<div class:list={["waves-background", className]} data-waves={preset}>
	<canvas aria-hidden="true"></canvas>
</div>

<script>
	import {
		initWavesBackground,
		WAVES_BRAND,
		WAVES_ORIGINAL,
		WAVES_ROSE,
		WAVES_SAND,
		type WavesController,
		type WavesUniforms,
	} from "../../scripts/waves";

	type WavesCanvas = HTMLCanvasElement & {
		__waves?: WavesController;
	};

	// Only the dark presets: the hero copy is paper-white, so light fields
	// would wash it out.
	const PRESET_ORDER = ["brand", "original"] as const;

	const PRESETS: Record<string, Partial<WavesUniforms>> = {
		brand: WAVES_BRAND,
		sand: WAVES_SAND,
		rose: WAVES_ROSE,
		original: WAVES_ORIGINAL,
	};

	// The footer promises "Press X for a surprise" — on this page it cycles
	// the hero shader through its presets.
	let presetIndex = 0;
	const isTyping = (target: EventTarget | null) =>
		target instanceof HTMLElement &&
		(target.isContentEditable ||
			target instanceof HTMLInputElement ||
			target instanceof HTMLTextAreaElement ||
			target instanceof HTMLSelectElement);

	document.addEventListener("keydown", (event) => {
		if (
			event.repeat ||
			event.altKey ||
			event.ctrlKey ||
			event.metaKey ||
			event.key.toLowerCase() !== "x" ||
			isTyping(event.target)
		) {
			return;
		}
		const canvases = document.querySelectorAll<WavesCanvas>(
			"[data-waves] canvas",
		);
		if (canvases.length === 0) return;
		presetIndex = (presetIndex + 1) % PRESET_ORDER.length;
		const preset = PRESETS[PRESET_ORDER[presetIndex]];
		canvases.forEach((canvas) => canvas.__waves?.setPreset(preset));
	});

	const boot = () => {
		document.querySelectorAll<HTMLElement>("[data-waves]").forEach((host) => {
			if (host.dataset.wavesBooted === "true") return;
			const canvas = host.querySelector<WavesCanvas>("canvas");
			if (!canvas) return;
			host.dataset.wavesBooted = "true";
			canvas.__waves =
				initWavesBackground(canvas, {
					preset: PRESETS[host.dataset.waves ?? ""] ?? WAVES_BRAND,
					// Start mid-motion so the first paint already shows waves.
					initialTime: 30,
				}) ?? undefined;
		});
	};

	const teardown = () => {
		document
			.querySelectorAll<WavesCanvas>("[data-waves] canvas")
			.forEach((canvas) => {
				canvas.__waves?.destroy();
				delete canvas.__waves;
			});
	};

	// View transitions swap the DOM, so listen for both the first parse and
	// Astro's page-load event (fired when the router takes over navigation).
	if (document.readyState === "loading") {
		document.addEventListener("DOMContentLoaded", boot, { once: true });
	} else {
		boot();
	}
	document.addEventListener("astro:page-load", boot);
	document.addEventListener("astro:before-swap", teardown);
</script>

<style>
	.waves-background canvas {
		display: block;
		width: 100%;
		height: 100%;
	}
</style>
