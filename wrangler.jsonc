{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "portfolio",
  "main": "./src/worker.ts",
  "compatibility_date": "2026-04-08",
  "compatibility_flags": ["nodejs_compat"],
  "assets": { "directory": "./dist" },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "portfolio-db",
    },
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "portfolio-bucket",
    },
  ],
  "kv_namespaces": [
    {
      "binding": "CACHE",
      "id": "060f94f5750044349e2d179c94b76c2d",
    },
  ],
  "images": {
    "binding": "IMAGES",
  },
  "cache": {
    "enabled": true,
    // Per-version cache. With this off (the default), a deploy starts from an
    // empty cache; with it on, cached HTML from a previous build keeps being
    // served after the deploy and points at asset hashes that no longer exist
    // (404 stylesheets/scripts). Content edits still purge via Astro.cache tags.
    "cross_version_cache": false,
  },
  "triggers": {
    "crons": ["* * * * *"],
  },
}
