{
  "name": "portfolio-monorepo",
  "version": "0.0.3",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "plugins/*"
  ],
  "overrides": {
    "zod": "4.5.4",
    "@astrojs/cloudflare": "15.0.0-beta.3"
  },
  "scripts": {
    "dev": "bun run --filter portfolio dev",
    "build": "bun run --filter portfolio build",
    "deploy": "bun run --filter portfolio deploy",
    "typecheck": "bun run --filter portfolio typecheck",
    "types": "bun run --filter portfolio types",
    "migrate": "bun run --filter portfolio migrate"
  },
  "patchedDependencies": {
    "emdash@1.3.1": "patches/emdash@1.3.1.patch",
    "@emdash-cms/admin@1.3.1": "patches/@emdash-cms%2Fadmin@1.3.1.patch"
  }
}
