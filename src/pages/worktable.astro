---
import WorktableShell from "../layouts/WorktableShell.astro";
import SectionHeader from "../components/SectionHeader.astro";
import WavesBackground from "../components/worktable/WavesBackground.astro";

/**
 * Worktable — macOS release page.
 *
 * EDIT ME when cutting a release: version and the download URL live in `app`.
 */
const app = {
	name: "Worktable",
	version: "0.1.0",
	// TODO: drop the DMG in public/downloads/ or point this at your host.
	downloadUrl: "https://malindhamsara.dev/_emdash/api/media/file/01M27NA3CWCDZ2JZ6H3GEQWQY7.01M27NA54YD3WWRZ81QJR395CA.dmg",
};

/**
 * Launch film — uploaded to EmDash media. Change this URL to swap the film;
 * clearing it falls back to the reserved 16:9 placeholder.
 */
const launchVideo = {
	src: "https://malindhamsara.dev/_emdash/api/media/file/01M27M0TVYRDVZ05KTD20Q2JBN.01M27M0YMVTBA3VRJRM2Q2V6P4.mp4",
	poster: "",
};

Astro.response.headers.set(
	"Cache-Control",
	"public, max-age=0, s-maxage=3600, stale-while-revalidate=86400",
);
---

<WorktableShell
	title="Worktable — Download for macOS"
	description="Worktable is a quiet desktop workspace for macOS. Watch the launch film and download the app."
>
	<main id="main" class="flex grow flex-col">
		{/* ——— Hero ——— */}
		<section
			class="relative isolate flex min-h-svh flex-col overflow-hidden bg-[#241b14] text-[#faf9f7]"
		>
			<WavesBackground preset="brand" class="absolute inset-0 -z-20" />
			<div
				aria-hidden="true"
				class="pointer-events-none absolute inset-0 -z-10 bg-gradient-to-b from-black/5 via-transparent to-black/40"
			>
			</div>

			<div
				class="relative z-10 mx-auto flex w-full max-w-site grow flex-col items-center justify-center gap-10 px-6 py-16 sm:gap-12 sm:px-10"
			>
				<div class="wt-rise" style="--wt-delay: 0ms">
					<div class="wt-float">
						<picture>
							<source
								srcset="/worktable/logo-dark.png"
								media="(prefers-color-scheme: dark)"
							/>
							<img
								src="/worktable/logo.png"
								alt="Worktable app icon"
								width="1024"
								height="1024"
								decoding="async"
								fetchpriority="high"
								class="h-40 w-40 drop-shadow-[0_30px_52px_rgba(0,0,0,0.4)] sm:h-52 sm:w-52"
							/>
						</picture>
					</div>
				</div>

				<div class="text-center">
					<p class="wt-rise kicker text-[#faf9f7]/60" style="--wt-delay: 90ms">
						For macOS
					</p>
					<h1 class="wt-rise display mt-5" style="--wt-delay: 180ms">
						Worktable
					</h1>
					<p
						class="wt-rise mt-5 font-serif text-xl italic text-[#faf9f7]/70 sm:text-2xl"
						style="--wt-delay: 270ms"
					>
						A quiet desktop workspace.
					</p>
				</div>

				<a
					href="#film"
					aria-label="Watch the film"
					class="wt-rise group mt-2 inline-flex flex-col items-center sm:mt-4"
					style="--wt-delay: 360ms"
				>
					<span
						aria-hidden="true"
						class="wt-cue block h-10 w-[1.5px] bg-[#faf9f7]/60 transition-colors group-hover:bg-[#faf9f7]"
					></span>
				</a>
			</div>
		</section>

		{/* ——— Launch film ——— */}
		<section
			id="film"
			data-wt-film
			class="wt-film"
			aria-label="Worktable launch film"
		>
			<div class="wt-film-stage">
				<div class="wt-film-frame" data-wt-frame>
					{
						launchVideo.src ? (
							<>
								<video
									class="wt-film-media"
									data-wt-video
									src={launchVideo.src}
									poster={launchVideo.poster || undefined}
									muted
									loop
									playsinline
									preload="metadata"
								/>
							</>
						) : (
							<div class="wt-film-media wt-film-placeholder">
								<div class="text-center">
									<span
										aria-hidden="true"
										class="mx-auto flex size-14 items-center justify-center rounded-full border border-rule text-faint sm:size-16"
									>
										<svg
											viewBox="0 0 24 24"
											class="ml-0.5 size-5"
											fill="currentColor"
										>
											<path d="M8 5v14l11-7z" />
										</svg>
									</span>
									<p class="kicker mt-4">Launch film &middot; 16:9</p>
								</div>
							</div>
						)
					}
				</div>
			</div>
		</section>

		{/* ——— Download ——— */}
		<section
			id="download"
			class="mx-auto w-full max-w-site px-6 py-24 sm:px-10 sm:py-32"
		>
			<SectionHeader index="01" label="Download" />

			<div class="grid gap-10 sm:grid-cols-[minmax(0,1fr)_auto] sm:items-end">
				<div class="max-w-md">
					<h2 class="text-3xl font-semibold tracking-tight sm:text-4xl">
						Download for macOS.
					</h2>
					<p class="mt-4 text-lg/8 text-muted">
						Open the disk image, drag {app.name} into Applications, and you&rsquo;re
						set.
					</p>
				</div>

				<div class="flex w-fit flex-col items-center">
					<a
						href={app.downloadUrl}
						class="inline-flex items-center gap-3 rounded-full bg-ink px-6 py-3.5 text-sm font-medium text-bg transition-opacity duration-200 hover:opacity-85"
					>
						<svg
							viewBox="0 0 24 24"
							class="size-4"
							fill="currentColor"
							aria-hidden="true"
						>
							<path
								d="M17.05 12.54c-.03-2.6 2.12-3.84 2.22-3.9-1.21-1.77-3.09-2.01-3.76-2.04-1.6-.16-3.12.94-3.93.94-.81 0-2.06-.92-3.39-.9-1.74.03-3.35 1.01-4.25 2.57-1.81 3.14-.46 7.79 1.3 10.34.86 1.25 1.89 2.65 3.24 2.6 1.3-.05 1.79-.84 3.36-.84 1.57 0 2.01.84 3.38.81 1.4-.02 2.28-1.27 3.14-2.52.99-1.45 1.4-2.85 1.42-2.92-.03-.01-2.72-1.04-2.75-4.14z"
							></path>
							<path
								d="M14.4 4.6c.72-.87 1.2-2.08 1.07-3.29-1.03.04-2.28.69-3.02 1.56-.66.77-1.24 2-1.09 3.18 1.15.09 2.33-.58 3.04-1.45z"
							></path>
						</svg>
						Download for macOS
					</a>
					<p class="mt-4 text-sm text-faint">Version {app.version}</p>
				</div>
			</div>
		</section>
	</main>

	<script>
		import "../scripts/worktable";
	</script>
</WorktableShell>

<style>
	@keyframes wt-rise {
		from {
			opacity: 0;
			transform: translateY(14px);
		}
		to {
			opacity: 1;
			transform: translateY(0);
		}
	}

	.wt-rise {
		animation: wt-rise 900ms var(--ease-out-expo) both;
		animation-delay: var(--wt-delay, 0ms);
	}

	@keyframes wt-float {
		0%,
		100% {
			transform: translateY(0);
		}
		50% {
			transform: translateY(-10px);
		}
	}

	.wt-float {
		animation: wt-float 7s ease-in-out infinite;
	}

	@keyframes wt-cue {
		0%,
		100% {
			transform: scaleY(0.35);
			opacity: 0.55;
		}
		50% {
			transform: scaleY(1);
			opacity: 1;
		}
	}

	.wt-cue {
		transform-origin: top;
		animation: wt-cue 2.4s var(--ease-out-expo) infinite;
	}

	/* ——— Launch film runway ———
	   320vh of scroll: the sticky stage pins to the viewport while GSAP
	   (src/scripts/worktable.ts) expands the frame, holds it full-screen,
	   then returns it to its box for the download section. The class is
	   added by JS, so a no-JS / reduced-motion visit gets the boxed frame
	   without the empty runway. */
	.wt-film {
		position: relative;
	}

	:global(html.wt-film-live) .wt-film {
		height: 320vh;
	}

	.wt-film-stage {
		position: sticky;
		top: 0;
		display: flex;
		height: 100svh;
		align-items: center;
		justify-content: center;
		overflow: hidden;
	}

	.wt-film-frame {
		position: relative;
		width: min(72rem, calc(100vw - 3rem));
		aspect-ratio: 16 / 9;
		overflow: hidden;
		border: 1px solid var(--color-rule);
		border-radius: 0.75rem;
		background-color: var(--color-chip);
		will-change: width, height;
	}

	.wt-film-media {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	.wt-film-placeholder {
		display: grid;
		place-items: center;
	}

	.wt-film-sound {
		position: absolute;
		right: 1rem;
		bottom: 1rem;
		z-index: 10;
		display: grid;
		height: 2.5rem;
		width: 2.5rem;
		place-items: center;
		border-radius: 9999px;
		background-color: rgb(0 0 0 / 0.45);
		color: #fff;
		backdrop-filter: blur(6px);
		transition: background-color 200ms ease;
	}

	.wt-film-sound:hover {
		background-color: rgb(0 0 0 / 0.65);
	}

	.wt-film-sound .wt-sound-on {
		display: none;
	}

	.wt-film-sound[data-muted="false"] .wt-sound-off {
		display: none;
	}

	.wt-film-sound[data-muted="false"] .wt-sound-on {
		display: block;
	}

	@media (prefers-reduced-motion: reduce) {
		.wt-rise,
		.wt-float,
		.wt-cue {
			animation: none;
		}
	}
</style>
