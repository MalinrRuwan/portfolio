		<a href="#v2-work" data-v2-anchor="v2-work">
			<span class="v2-nav-num">02</span>
			<span class="v2-nav-label">Work</span>
		</a>
		<a href="#v2-index" data-v2-anchor="v2-index">
			<span class="v2-nav-num">03</span>
			<span class="v2-nav-label">Index</span>
		</a>
		<a href="#v2-contact" data-v2-anchor="v2-contact">
