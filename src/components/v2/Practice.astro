---

<section
	class="v2-scene scene-paper v2-practice"
	id="v2-practice"
	aria-label="Practice — make, own, measure"
	data-v2-practice
>
	<div class="practice-stage">
		<div class="beat beat-make" data-v2-beat="make">
			<p class="beat-kick kicker">01 / MAKE</p>
			<p class="practice-word word-make" data-v2-make>
				<span class="w-l">M</span><span class="w-l">A</span><span class="w-l">K</span><span class="w-l">E</span>
			</p>
			<p class="beat-copy">Tools that are simple, ownable, and well-made.</p>
		</div>

		<div class="beat beat-own" data-v2-beat="own">
			<p class="beat-kick kicker">02 / OWN</p>
			<p class="practice-word word-own" data-v2-own>
				<span class="w-l">O</span><span class="w-l">W</span><span class="w-l">N</span>
			</p>
			<p class="beat-copy">Convenience is rented; plain text is owned.</p>
		</div>

		<div class="beat beat-measure" data-v2-beat="measure">
			<p class="beat-kick kicker">03 / MEASURE</p>
			<p class="practice-word word-measure" data-v2-measure>
				<span class="w-m"><span class="rev-in">M</span></span><span class="w-m"><span class="rev-in">E</span></span><span class="w-m"><span class="rev-in">A</span></span><span class="w-m"><span class="rev-in">S</span></span><span class="w-m"><span class="rev-in">U</span></span><span class="w-m"><span class="rev-in">R</span></span><span class="w-m"><span class="rev-in">E</span></span>
			</p>
			<p class="beat-copy">Twice. Cut once &mdash; it works on keyboards too.</p>
		</div>

		{/* Hairline columns: MAKE's vertical strokes → OWN's negative space
		    → sheared parallelogram planes */}
		<div class="columns film" aria-hidden="true" data-v2-columns>
			<span class="col"></span>
			<span class="col"></span>
			<span class="col"></span>
			<span class="col"></span>
			<span class="col"></span>
			<span class="col"></span>
		</div>

		{/* The logo's three strokes as parallelogram planes */}
		<div class="mplanes film" aria-hidden="true" data-v2-mplanes>
			<span class="mplane mp-wing mp-l"></span>
			<span class="mplane mp-core"></span>
			<span class="mplane mp-wing mp-r"></span>
		</div>

		<div class="flash film" aria-hidden="true" data-v2-flash></div>
	</div>
</section>
